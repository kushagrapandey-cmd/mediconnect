# Server-side Neon PostgreSQL connection URL. Never expose in frontend variables.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional canonical origin; defaults to the request origin on Vercel.
# APP_ORIGIN=https://your-mediconnect-domain.vercel.app
PORT=4000

# Optional email flows: use a verified sender and HTTPS APP_ORIGIN.
# RESEND_API_KEY=
# MAIL_FROM=MediConnect <support@your-verified-domain.example>
